/mvnw text eol=lf
*.cmd text eol=crlf

# El motor de politicas corre en un contenedor Linux. Con core.autocrlf=true (el default de
# Windows) estos archivos salen en CRLF al hacer checkout, y entonces `opa fmt --fail` rechaza
# las politicas y el shebang de los scripts falla con "bad interpreter". El equipo es mixto
# Mac/Windows, asi que fijarlo aqui es lo unico que lo mantiene reproducible en las dos.
*.rego text eol=lf
security-policy-engine/scripts/** text eol=lf

# Scripts de arranque de las imagenes: el shebang falla con CRLF ("bad interpreter").
docker/*.sh text eol=lf
# El edge corre en un contenedor Linux: con core.autocrlf=true un entrypoint o un healthcheck en CRLF
# falla con "no such file or directory" (el shebang termina en retorno de carro). Se fija LF para todo edge/ y los scripts.
edge/** text eol=lf
*.sh text eol=lf
