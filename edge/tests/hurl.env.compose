# Variables de la suite hurl — solo válidas DENTRO del Compose (servicio `hurl`, misma red).
# Contrato: PLAN-HU-027 §7.6. El pipeline sobreescribe run_id con --variable run_id=<Build.BuildId>.
edge_url=http://edge:8088
kc_url=http://keycloak:8080
kc_realm=security-baseline
tester_user=edge-tester
tester_password=EdgeTester#2026
run_id=local
# Identidad tecnica del PEP en el realm de CI (HU-030): solo para probar el canal /internal/v1.
pep_internal_client_id=security-pep-internal
pep_internal_secret=edge-ci-pep-internal-secret-2026
# PDP directo dentro de la red del Compose: la ruta que usa el PEP para el canal /internal (HU-030).
pdp_url=http://pdp:8080
