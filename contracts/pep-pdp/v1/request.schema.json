{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolicitudAcceso v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requestId",
    "correlationId",
    "timestamp",
    "application",
    "resource",
    "context"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "environment"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "action"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9/._~-]*$"
        },
        "action": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "channel"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "channel": {
          "const": "HTTP"
        }
      }
    }
  }
}
