SECURITY_DOCKER_ORG=replace-with-your-dockerhub-organization
SECURITY_VERSION=0.1.9
KEYCLOAK_PORT=19090
PDP_PORT=18080
PEP_PORT=18081
# Local: no exige OTP/WebAuthn para administrar recursos. Producción debe ser true.
PDP_SECURITY_MFA_ENABLED=false
# Orígenes de sus frontends, separados por comas (sin espacios). Agregue el de su aplicación.
PDP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
PDP_LOGIN_ALLOWED_RETURN_ORIGINS=http://localhost:5174
